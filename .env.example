# Copy this file to .env and change the values if needed.
# Every setting is optional: the defaults below are used when .env is missing.

# Main chat model (replaces watsonx ibm/granite-4-h-small)
OLLAMA_MODEL=granite4:tiny-h

# Second chat model for Exercise 1 (replaces watsonx llama-4-maverick)
OLLAMA_SECOND_MODEL=llama3.2:3b

# Embedding model (same model as the lab: granite-embedding-278m-multilingual)
OLLAMA_EMBED_MODEL=granite-embedding:278m

# Where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434
